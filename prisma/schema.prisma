datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  userType      String   @default("user") // "user" or "creator"
  isAdmin       Boolean  @default(false) 
  
  // Creator fields
  creator       Creator?
  
  accounts      Account[]
  sessions      Session[]
  orders        order[]
  cart          CartItem[]
}

model Creator {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String   @unique
  title         String
  slug          String   @unique
  description   String
  image         String   // Creator's profile/brand image
  products      Product[]
}

model Product {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  title         String
  price         Decimal
  options       Json[]
  featured      Boolean  @default(false)
  description   String
  img           String?
  
  creator       Creator  @relation(fields: [creatorSlug], references: [slug])
  creatorSlug   String
  
  cartItems     CartItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  price     Decimal
  products  Json[]
  status    String   @default("pending")
  intentId  String?  @unique
  user      User     @relation(fields: [userEmail], references: [email])
  userEmail String
}

model CartItem {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userEmail], references: [email])
  userEmail String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  options   String
  img       String
  price     Decimal
  title     String
}